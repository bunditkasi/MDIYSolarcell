# =============================================================================
# MR.DIY Thailand — Enterprise Solar PV Monitoring System
# Copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#
# NEVER commit `.env`. NEVER put real credentials in this file.
# =============================================================================

# --- PostgreSQL / TimescaleDB -----------------------------------------------
POSTGRES_USER=solarcell
POSTGRES_PASSWORD=change_me_before_first_run
POSTGRES_DB=solarcell
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port exposed on the host machine (change if 5432 is already in use)
POSTGRES_HOST_PORT=5432

# --- Redis (ingestion queue + Solcast response cache) -----------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379

# --- Backend ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_HOST_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Origins allowed by pattern rather than by name. Vercel gives every deployment
# its own hostname, so listing them exactly goes stale on each deploy.
#
# Keep this as narrow as the hosting allows. The backend runs AUTH_MODE=mock,
# which authenticates nobody: any origin that reaches it can read every branch's
# address, CapEx and live generation. Set it empty to allow none.
CORS_ORIGIN_REGEX=https://[a-z0-9-]+\.vercel\.app\Z
# Set true to log every SQL statement (useful for verifying that filtering
# and pagination are pushed down to the database, not done in Python).
SQL_ECHO=false

# --- Authentication ---------------------------------------------------------
# Phase 1 = mock   |   Phase 2 (corporate IT) = enterprise_sso
AUTH_MODE=mock
MOCK_USER_ID=00000000-0000-0000-0000-000000000001
MOCK_USER_NAME=Phase 1 Local User
MOCK_USER_EMAIL=local@example.invalid
MOCK_USER_ROLES=admin
# Phase 2 only — leave blank during Phase 1.
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_AUTHORITY=
SSO_JWKS_URL=
SSO_AUDIENCE=

# --- Secrets provider -------------------------------------------------------
# env   = read from environment (LOCAL DEVELOPMENT ONLY)
# vault = HashiCorp Vault / corporate secrets manager (production)
SECRETS_PROVIDER=env
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=solarcell

# --- OEM portal credentials (development only) ------------------------------
# In production these live in Vault and are fetched in-memory at run time.
# The database only ever stores the *reference name* (data_adapters.secrets_ref),
# never the credential itself.
#
# Naming pattern:  SECRET__<SECRETS_REF>__USERNAME / __PASSWORD / __APIKEY
#
# SECRET__HUAWEI_CENTRAL__USERNAME=
# SECRET__HUAWEI_CENTRAL__PASSWORD=
# SECRET__GROWATT_LEGACY_NORTH__USERNAME=
# SECRET__GROWATT_LEGACY_NORTH__PASSWORD=

# --- Solcast (Virtual Pyranometer for PR%) ----------------------------------
# Without a key the system still runs; performance_ratio is reported as null.
SOLCAST_API_KEY=
SOLCAST_BASE_URL=https://api.solcast.com.au
WEATHER_CACHE_TTL_SECONDS=1800

# --- Analytics thresholds ---------------------------------------------------
# Spec: Green = PR >= 75%, Yellow = PR < 75% or string anomaly, Red = offline.
PR_GREEN_THRESHOLD=75.0
STRING_VARIANCE_THRESHOLD_PCT=10.0

# Status threshold used when PR% cannot be computed — that is, whenever
# SOLCAST_API_KEY is empty, which is the current state.
#
# Read as a percentage OF THE FLEET MEDIAN specific yield (kWh/kWp) for the same
# day, not as an absolute figure. An absolute kWh/kWp threshold cannot work: the
# number climbs all day, so any fixed value calls the whole fleet unhealthy every
# morning, and an overcast day lights up all 163 branches at once. Judged against
# its peers under the same sky, a branch is flagged only when it genuinely falls
# behind.
YIELD_GREEN_THRESHOLD_PCT=80.0
# Branches that must be reporting before the median is trusted. Below this the
# median is an accident of which sites happened to answer.
YIELD_MIN_PEERS=5

# How stale a reading may be before a site counts as offline.
#
# LEAVE THIS BLANK. It is derived as 2.5x each vendor's OWN poll interval,
# because the two cannot be chosen independently: a site can never look fresher
# than the rate at which it is polled. Pinning 15 here while polling hourly marks
# the whole fleet RED permanently — the alarm then reports the poll schedule, not
# the plant.
#
# Blank therefore yields two different thresholds: 37 minutes for Atmoce at its
# 15-minute cadence, 300 minutes for Huawei at two hours. Setting a number here
# overrides BOTH with one value, which is almost never what you want while the
# vendors are polled at different rates.
DEVICE_OFFLINE_AFTER_MINUTES=

# --- Ingestion --------------------------------------------------------------
INGESTION_ENABLED=true

# Poll cadence during daylight.
#
# 15 matches Atmoce's native collection interval (API Reference v1.2.2: "the
# shortest collection interval is 15 minutes, 96 data points per day"), so no
# published data point is discarded.
#
# Affordable only because the frequent sweep uses the BULK endpoint, which
# covers 100 branches in one call: ~3 calls a sweep, ~4,200 a month against the
# 10,000 cap. Inverter-level readings cost one call per branch and belong to the
# daily detail run — pulling them every 15 minutes would cost ~148,000 calls a
# month and exhaust the budget in under two days.
INGESTION_POLL_INTERVAL_MIN=15

# Huawei is polled on its own, much slower cadence.
#
# Its northbound API throttles on request RATE and answers failCode 407 —
# "interface access frequency exceeded" — which locks the interface out rather
# than merely refusing one call. A single uninterrupted pass over the 51 mapped
# branches tripped it from about the fifth site onward.
#
# Changing this also changes when a Huawei branch counts as offline: the
# staleness threshold is derived from this number, so the two stay consistent.
INGESTION_POLL_INTERVAL_MIN_HUAWEI=120

# Vendor accounts the scheduler sweeps: vendor:secrets_ref[:base_url], comma
# separated.
#
# One vendor can have several accounts, and they must each be swept: Huawei's
# 50-branch fleet and Mueang Nan sit under different logins. The value here is a
# LOOKUP KEY, never a credential — the actual username and secret are read
# through the secrets provider at the moment of use, from SECRET__<REF>__*.
INGESTION_ACCOUNTS=atmoce:atmoce_main,huawei:huawei_korn,huawei:huawei_nan

# Daylight window, site-local. Outside it PV output is zero and polling only
# burns vendor API quota.
INGESTION_DAYLIGHT_START=06:30
INGESTION_DAYLIGHT_END=18:00
INGESTION_TIMEZONE=Asia/Bangkok

# Panel/string detail costs one call PER SITE (vs 100 sites per bulk call), so
# it runs on a much slower cadence.
INGESTION_DETAIL_INTERVAL_HOURS=24

SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_SECONDS=60

# --- ESG / Carbon accounting (Thailand TGO) ---------------------------------
# TGO revises this factor periodically — keep the year alongside the value so
# historical reports stay reproducible.
TGO_GRID_EMISSION_FACTOR=0.4999
TGO_EF_EFFECTIVE_YEAR=2024


# --- Frontend ---------------------------------------------------------------
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_CENTER_LAT=13.7563
NEXT_PUBLIC_MAP_CENTER_LNG=100.5018
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=5.2
