# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
vault-token

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- Node / Next.js ---
node_modules/
.next/
out/
.pnpm-store/
npm-debug.log*
yarn-error.log*

# --- Docker / data ---
pgdata/
redis-data/

# --- Claude Code: machine-local settings ---
# settings.json is shared project config and belongs in the repo.
# settings.local.json holds one developer's own permission grants — committing
# it would hand everyone who clones the approvals this machine chose to give.
.claude/settings.local.json

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Build info ---
tsconfig.tsbuildinfo
